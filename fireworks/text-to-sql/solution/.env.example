# Copy this file to .env and fill in real values. .env is gitignored.
#
# Fireworks API key. Required only for:
#   - capturing RecordedClient fixtures (W1)
#   - `make eval` (live run against the eval corpus, W4)
# Everything else (tests, lint, typecheck, offline eval replay) runs without it.
FIREWORKS_API_KEY=

# Primary model: code-capable instruct model with JSON-schema response_format support (D7, D10).
T2S_MODEL=accounts/fireworks/models/kimi-k2p7-code

# Fallback / alternate model, e.g. for latency or cost comparison in the eval report.
T2S_MODEL_ALT=accounts/fireworks/models/deepseek-v4p1-flash
