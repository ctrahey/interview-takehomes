# Copy this file to .env and fill in real values. .env is gitignored.
#
# Fireworks API key. Required only for:
#   - capturing RecordedClient fixtures (W1)
#   - `make eval` (live run against the eval corpus, W4)
# Everything else (tests, lint, typecheck, offline eval replay) runs without it.
FIREWORKS_API_KEY=

# Primary model: code-capable instruct model with JSON-schema response_format support (D7, D10).
T2S_MODEL=accounts/fireworks/models/kimi-k2p7-code

# Fallback / alternate model, e.g. for latency or cost comparison in the eval report.
T2S_MODEL_ALT=accounts/fireworks/models/deepseek-v4p1-flash

# --- Docker / docker-compose only (W14) -------------------------------------
# This same .env is read by `docker compose` (env_file, and for ${VAR}
# substitution in docker-compose.yml). See docker/README.md.
#
# Extra browser origins allowed to call the API, beyond the built-in
# localhost:5173/3000 defaults (t2s_api.app.DEFAULT_CORS_ORIGINS) -- needed
# if you run a UI dev server on a different host/port against the
# containerized API. Comma-separated.
# T2S_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#
# Point the containerized app's foundation metadata store (projects,
# sessions, models, activities) at the `postgres` compose profile instead of
# the default SQLite volume. Leave unset to stay on SQLite.
# T2S_API_DB_URL=postgresql+psycopg://t2s:t2s@postgres:5432/t2s
# T2S_DB_URL=postgresql+psycopg://t2s:t2s@postgres:5432/t2s
